light_mode unshaded;
// Deform the already composed sprite so skin, clothing and female displacement stay together.
// The input is already lit. Run before water/stealth/outline post effects.
uniform highp vec2 body_origin;
uniform highp vec2 body_x;
uniform highp vec2 body_y;
uniform highp vec2 pixel_x;
uniform highp vec2 pixel_y;
uniform highp vec2 facing;
uniform highp vec4 gait;
uniform highp vec4 action;

void fragment() {
    highp vec2 delta = SCREEN_UV - body_origin;
    highp vec2 p = vec2(dot(delta, body_x), dot(delta, body_y)) + vec2(16.0);
    highp float upper = clamp((25.0 - p.y) / 15.0, 0.0, 1.0);
    highp float leg = clamp((p.y - 21.0) / 8.0, 0.0, 1.0);
    highp float side = p.x < 16.0 ? -1.0 : 1.0;
    highp float profile = abs(facing.x);
    highp float arm = step(6.0, abs(p.x - 16.0)) * clamp((p.y - 11.0) / 8.0, 0.0, 1.0) * step(p.y, 24.0);
    highp vec2 shift;
    shift.x = gait.x * side * leg * mix(0.25, 1.0, profile);
    shift.y = -max(0.0, gait.x * side) * leg * 0.45 - gait.y * leg * 0.25;
    shift.x += facing.x * (gait.w - action.y) * upper;
    shift.y += (-gait.z - action.w + action.z) * upper;
    shift.y += facing.y * (gait.w - action.y) * upper * 0.7;
    shift.x += action.x * arm * mix(side, facing.x, profile);
    shift.y -= action.x * arm * (1.0 - profile) * 0.5;
    // Quantize in source pixels; do not blur the original pixel art at fractional zoom.
    shift = floor(shift + vec2(0.5));
    highp vec2 source = UV - (pixel_x * shift.x + pixel_y * shift.y) * TEXTURE_PIXEL_SIZE;
    highp float inside = step(0.0, source.x) * step(source.x, 1.0) * step(0.0, source.y) * step(source.y, 1.0);
    COLOR = zTexture(clamp(source, vec2(0.0), vec2(1.0))) * inside;
}
