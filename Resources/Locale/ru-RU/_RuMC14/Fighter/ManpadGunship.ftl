rumc-manpad-gunship-lock-lost = Захват потерян.
rumc-manpad-gunship-examine-aimed = [color=orange]Поднят. Ищет штурмовик над оператором.[/color]
rumc-manpad-gunship-examine-locking = [color=orange]Захватывает цель...[/color]
rumc-manpad-gunship-examine-locked = [color=red]Цель захвачена. Готов к пуску.[/color]
