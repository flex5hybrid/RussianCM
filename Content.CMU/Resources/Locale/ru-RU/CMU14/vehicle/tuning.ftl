cmu-vehicle-module-examine-armor = [color=lightgray]На корпус установлен модуль бронирования.[/color]
cmu-vehicle-module-examine-armor-heavy = [color=lightgray]На корпус наварен тяжёлый бронекорпус.[/color]
cmu-vehicle-module-examine-wheels-armored = [color=lightgray]Колёса обшиты наварной бронёй.[/color]
cmu-vehicle-module-examine-bullbar = [color=lightgray]Спереди установлен шипованный кенгурятник.[/color]
cmu-vehicle-module-examine-engine = [color=lightgray]Под капотом рычит форсированный двигатель на тяжёлом топливе.[/color]
