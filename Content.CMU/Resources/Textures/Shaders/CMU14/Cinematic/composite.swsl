light_mode unshaded;
blend_mode none;

#include "/Textures/Shaders/CMU14/Cinematic/frame.swsl"

uniform sampler2D scene_texture;
uniform sampler2D surface_texture;
uniform sampler2D emission_texture;
uniform sampler2D atmosphere_texture;
uniform sampler2D bloom_compact;
uniform sampler2D bloom_medium;
uniform sampler2D bloom_wide;
uniform bool atmospheric_effects;
uniform highp float local_exposure;
uniform highp int debug_view;
uniform bool glow_enabled;
uniform sampler2D blocker_texture;
uniform sampler2D direct_texture;
uniform sampler2D reflection_texture;
uniform sampler2D material_texture;
uniform sampler2D native_texture;

void fragment()
{
    highp vec2 uv = frameUv(FRAGCOORD.xy);
    highp vec4 scene = texture2D(scene_texture, uv);
    highp float visible = visibleAt(frameWorld(uv))
        * texture2D(surface_texture, uv).a * step(0.001, scene.a);
    highp vec3 core = texture2D(emission_texture, uv).rgb;
    highp vec3 compact = texture2D(bloom_compact, uv).rgb;
    highp vec3 medium = texture2D(bloom_medium, uv).rgb;
    highp vec3 wide = texture2D(bloom_wide, uv).rgb;
    highp vec3 atmosphere = vec3(0.0);
    if (atmospheric_effects)
        atmosphere = texture2D(atmosphere_texture, uv).rgb;
    highp vec2 receiver = texture2D(blocker_texture, uv).rg;
    highp float contact = clamp(texture2D(blocker_texture, uv).b, 0.0, 0.2) * visible;
    highp float air = 1.0 - receiver.r * (1.0 - clamp(receiver.g, 0.0, 1.0));
    highp vec3 radiance = glow_enabled
        ? core * 0.8 + (compact * 0.95 + medium * 0.25 + wide * 0.75) * air : vec3(0.0);
    radiance += atmosphere * air * 0.24;
    // Visibility comes from native FOV and geometry, never from the brightness of the old frame.
    radiance *= local_exposure * visible;
    highp float peak = max(max(radiance.r, radiance.g), radiance.b);
    highp vec3 response = radiance / (1.0 + peak);
    if (debug_view == 0)
        COLOR = vec4(scene.rgb * (1.0 - contact) + max(vec3(0.0), vec3(1.0) - scene.rgb) * response, scene.a);
    else
    {
        highp vec3 diagnostic = vec3(0.0);
        if (debug_view == 1) diagnostic = texture2D(native_texture, uv).rgb;
        if (debug_view == 2 || debug_view == 3) diagnostic = texture2D(direct_texture, uv).rgb;
        if (debug_view == 4 || debug_view == 5) diagnostic = core;
        if (debug_view == 6) diagnostic = compact;
        if (debug_view == 7) diagnostic = medium * 0.25 + wide * 0.75;
        if (debug_view == 8) diagnostic = texture2D(reflection_texture, uv).rgb;
        if (debug_view == 9) diagnostic = texture2D(material_texture, uv).rgb;
        if (debug_view == 10) diagnostic = atmosphere;
        if (debug_view == 11) diagnostic = texture2D(blocker_texture, uv).rrr;
        if (debug_view == 12) diagnostic = core * 0.8 + compact * 0.95 + medium * 0.25 + wide * 0.75;
        if (debug_view == 13) diagnostic = vec3(contact);
        highp float diagnostic_peak = max(max(diagnostic.r, diagnostic.g), diagnostic.b);
        COLOR = vec4(diagnostic / (1.0 + diagnostic_peak) * visible, scene.a);
    }
}
