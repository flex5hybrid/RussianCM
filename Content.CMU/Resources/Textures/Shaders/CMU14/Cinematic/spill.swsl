light_mode unshaded;
blend_mode add;

#include "/Textures/Shaders/CMU14/Cinematic/source.swsl"

uniform sampler2D material_texture;
uniform highp float spill_strength;

void fragment()
{
    highp vec2 uv = frameUv(FRAGCOORD.xy);
    highp vec2 world = frameWorld(uv);
    if (visibleAt(emission_position) < 0.5 || visibleAt(world) < 0.5)
        discard;
    highp vec4 material = texture2D(material_texture, uv);
    highp float attenuation = sourceAttenuation(world) * sourceMask(world, 1.0);
    highp vec2 delta = world - source_position;
    // Reflection lobes stay in world coordinates, preserving pixel detail and camera stability.
    // Wet surfaces have a longer lobe, polished metal a compact brighter highlight.
    highp float roughness = max(material.g, 0.12);
    highp float stretch = 0.3 + material.b * 2.5;
    highp vec2 reflected = delta + vec2(0.0, 0.35);
    highp float glint = exp(-reflected.x * reflected.x / (0.12 + roughness * 0.5)
        - reflected.y * reflected.y / stretch);
    highp float seams = mix(0.72, 1.0, smoothstep(0.34, 0.49, abs(fract(world.x) - 0.5)));
    highp float reflection = glint * material.r * (1.0 - roughness * 0.5) * seams;
    highp float spill = spill_strength * attenuation;
    highp float amount = (spill + reflection * attenuation * 0.65) * source_energy * material.a;
    COLOR = vec4(source_color * amount, 1.0);
}
