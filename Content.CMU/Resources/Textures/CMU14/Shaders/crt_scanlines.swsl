light_mode unshaded;

uniform highp float height;
uniform highp float pitch;
uniform highp float strength;
uniform highp float grain;
uniform highp vec3 phosphor;

void fragment() {
    highp float row = UV.y * height;
    highp float wave = 0.5 - 0.5 * cos(row / max(pitch, 2.0) * 6.2831853);
    highp float scan = wave * wave * 0.85 * strength;
    highp float signal = zRandom(FRAGCOORD.xy * SCREEN_PIXEL_SIZE + vec2(TIME * 0.07, 0.0)).x;
    highp float noise = (signal - 0.5) * grain * 0.045 * strength;
    highp float light = max(noise, 0.0);
    // Premultiplied signal light is visible over a dark terminal as well as over bright text.
    // No source capture or image displacement is needed for scrolling reading surfaces.
    COLOR = vec4(phosphor * light, clamp(scan + abs(noise), 0.0, 0.82));
}
