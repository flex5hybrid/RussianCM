light_mode unshaded;

uniform highp float Intensity;
uniform highp float Sharpness;
uniform highp vec2 PixelSize;

void fragment() {
    highp vec4 source = zTexture(UV);

    // Retain the existing viewport sharpening without a second framebuffer pass.
    if (Sharpness > 0.0) {
        highp vec4 blur = zTexture(UV + vec2(PixelSize.x, 0.0));
        blur += zTexture(UV + vec2(-PixelSize.x, 0.0));
        blur += zTexture(UV + vec2(0.0, PixelSize.y));
        blur += zTexture(UV + vec2(0.0, -PixelSize.y));
        source = clamp(source + Sharpness * (source - blur * 0.25), 0.0, 1.0);
    }

    highp float luminance = dot(source.rgb, vec3(0.2126, 0.7152, 0.0722));
    highp float brightest = max(source.r, max(source.g, source.b));
    highp float darkest = min(source.r, min(source.g, source.b));
    highp float saturation = (brightest - darkest) / max(brightest, 0.0001);

    // Deepen the lower tones while preserving the endpoints and bright colored signals.
    highp float signal = smoothstep(0.7, 1.0, saturation) * smoothstep(0.35, 0.85, brightest);
    highp float contrast = pow(max(luminance, 0.0001), 0.45 * (1.0 - 0.8 * signal));
    highp float shadow = 1.0 - smoothstep(0.02, 0.5, luminance);
    highp float neutral = 1.0 - saturation;
    highp vec3 graded = mix(source.rgb, vec3(luminance), 0.28 * neutral * shadow);
    graded *= mix(vec3(1.0), vec3(0.74, 0.9, 1.0), shadow * neutral);
    graded *= contrast;

    // A multiplicative curve leaves black and transparent Z-level openings intact.
    COLOR = vec4(mix(source.rgb, graded, clamp(Intensity, 0.0, 1.0)), source.a);
}
