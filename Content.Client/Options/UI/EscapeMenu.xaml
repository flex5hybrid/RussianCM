<ui1:EscapeMenu xmlns="https://spacestation14.io"
            xmlns:changelog="clr-namespace:Content.Client.Changelog"
            xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
            xmlns:ui="clr-namespace:Content.Client.Voting.UI"
            xmlns:ui1="clr-namespace:Content.Client.Options.UI"
            xmlns:hud="clr-namespace:Content.Client.CMU14.Interface.Hud"
            Title="{Loc 'ui-escape-title'}"
            Resizable="False">

    <hud:CmuHudPanel MenuSurface="True">
    <BoxContainer Orientation="Vertical" SeparationOverride="5" MinWidth="310">
        <PanelContainer Name="RoundStatusPanel" Access="Public" StyleClasses="CmuHudInset">
            <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="10 8">
                <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                    <Label Text="{Loc 'ui-escape-status-title'}" StyleClasses="CmuHudHeading"/>
                    <Control HorizontalExpand="True"/>
                    <Label Access="Public" Name="RoundTimeValue" StyleClasses="CmuHudBody"/>
                </BoxContainer>
                <PanelContainer StyleClasses="LowDivider" />
                <BoxContainer Orientation="Vertical" SeparationOverride="3">
                    <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                        <Label Text="{Loc 'ui-escape-status-map'}" StyleClasses="CmuHudBody CmuHudMuted" MinSize="96 0"/>
                        <Label Access="Public" Name="MapValue" Text="{Loc 'ui-escape-status-unknown'}" ClipText="True" HorizontalExpand="True" MinWidth="220" StyleClasses="CmuHudBody"/>
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                        <Label Text="{Loc 'ui-escape-status-ship-map'}" StyleClasses="CmuHudBody CmuHudMuted" MinSize="96 0"/>
                        <Label Access="Public" Name="ShipMapValue" Text="{Loc 'ui-escape-status-no-ship'}" ClipText="True" HorizontalExpand="True" MinWidth="220" StyleClasses="CmuHudBody"/>
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                        <Label Text="{Loc 'ui-escape-status-gamemode'}" StyleClasses="CmuHudBody CmuHudMuted" MinSize="96 0"/>
                        <Label Access="Public" Name="GamemodeValue" Text="{Loc 'ui-escape-status-unknown'}" ClipText="True" HorizontalExpand="True" MinWidth="220" StyleClasses="CmuHudBody"/>
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                        <Label Text="{Loc 'ui-escape-status-round'}" StyleClasses="CmuHudBody CmuHudMuted" MinSize="96 0"/>
                        <Label Access="Public" Name="RoundValue" HorizontalExpand="True" Align="Right" StyleClasses="CmuHudBody"/>
                        <Label Text="{Loc 'ui-escape-status-players'}" StyleClasses="CmuHudBody CmuHudMuted" MinSize="70 0"/>
                        <Label Access="Public" Name="PlayersValue" Align="Right" StyleClasses="CmuHudBody"/>
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>
        <PanelContainer StyleClasses="LowDivider" Margin="0 2.5 0 2.5" />
        <Button Access="Public" Name="RulesButton" Text="{Loc 'ui-escape-rules'}" StyleClasses="Caution" />
        <Button Access="Public" Name="GuidebookButton" Text="{Loc 'ui-escape-guidebook'}" />
        <Button Access="Public" Name="WikiButton" Text="{Loc 'ui-escape-wiki'}" />
        <PanelContainer StyleClasses="LowDivider" Margin="0 2.5 0 2.5" />
        <changelog:ChangelogButton Access="Public" Name="ChangelogButton"/>
        <Button Access="Public" Name="FeedbackButton" Text="{Loc 'ui-escape-feedback'}" />
        <Button Access="Public" Name="AdminRemarksButton" Text="{Loc 'ui-escape-remarks'}" />
        <Button Access="Public" Name="CreditsButton" Text="{Loc 'server-info-credits-button'}" />
        <Button Access="Public" Name="PatronPerksButton" Text="{Loc 'rmc-ui-patron-perks'}" StyleClasses="Caution" Visible="False" />
        <Button Access="Public" Name="RoadmapButton" Text="{Loc 'cm-ui-roadmap'}" StyleClasses="Caution" Visible="False" />
        <ui:VoteCallMenuButton />
        <PanelContainer StyleClasses="LowDivider" Margin="0 2.5 0 2.5" />
        <Button Access="Public" Name="OptionsButton" Text="{Loc 'ui-escape-options'}" />
        <PanelContainer StyleClasses="LowDivider" Margin="0 2.5 0 2.5" />
        <Button Access="Public" Name="DisconnectButton" Text="{Loc 'ui-escape-disconnect'}" StyleClasses="negative OpenLeft" />
        <Button Access="Public" Name="QuitButton" Text="{Loc 'ui-escape-quit'}" StyleClasses="negative OpenRight" />
    </BoxContainer>
    </hud:CmuHudPanel>
</ui1:EscapeMenu>
